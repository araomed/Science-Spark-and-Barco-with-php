APP_NAME="Science Spark Lab System"
APP_ENV=development
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sciencespark_lab_db
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

UPLOAD_PATH=storage/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
